# Adzuna — sign up free at https://developer.adzuna.com
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# ---------------------------------------------------------------------------
# LLM Provider
#
# LLM_PROVIDER is the default for both scoring and document generation.
# Override each independently with SCORING_PROVIDER / DOCUMENT_PROVIDER.
# Valid values: "anthropic" | "openai" | "ollama"
#
# Recommended split: use a local Ollama model for fast scoring and a cloud
# API for resume + cover letter generation where output quality matters most.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# SCORING_PROVIDER=ollama        # override scoring to use a local model
# DOCUMENT_PROVIDER=anthropic    # keep document generation on a cloud API

# Anthropic — required when any provider is set to "anthropic"
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — required when any provider is set to "openai"
# Get a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o

# Ollama — required when any provider is set to "ollama"
# OLLAMA_BASE_URL points to the ollama service name inside Docker Compose.
# Change to http://localhost:11434 if running Ollama outside of Docker.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# Writing sample — optional, for tone/style matching in resume and cover letters
# Place your writing sample at backend/writing_sample.txt.
# This cap prevents the sample from overflowing local model context windows.
# WRITING_SAMPLE_MAX_WORDS=400

# Job search parameters (location is optional — leave blank to search all of the US)
JOB_SEARCH_KEYWORDS="remote software engineer"
JOB_SEARCH_LOCATION=

# Minimum score to show in dashboard (0-100)
MIN_DISPLAY_SCORE=60

# Logging — set to DEBUG to print full LLM prompts to the backend log
# LOG_LEVEL=DEBUG
